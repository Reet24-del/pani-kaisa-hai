# Copy to .env.local. `npx sanity init` fills the first two in for you.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-20

# Server only — never exposed to the browser. Create at
# sanity.io/manage → API → Tokens, with Editor rights.
SANITY_API_WRITE_TOKEN=

# Later milestones
ANTHROPIC_API_KEY=
RESEND_API_KEY=
ALERT_FROM_EMAIL=
